# Copy to `.env` for local overrides (never commit `.env`).

# APP_NAME=classino
# APP_VERSION=0.1.0

# HTTP_HOST=127.0.0.1
# HTTP_PORT=8080

# DATABASE_DRIVER=sqlite
# DATABASE_PATH=data/classino.db

# FRONTEND_DIR=frontend

# JWT_ACCESS_TTL=24h
# JWT_COOKIE_NAME=access_token

# Required for `classino serve` (JWT login)
# JWT_SECRET=change-me-to-a-long-random-string

# Secret path segment for admin console (must match frontend assets/config.js adminPathSecret)
# ADMIN_PATH_SECRET=sys-ingress
